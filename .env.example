# x402 Gateway Configuration
CDP_API_KEY_ID=your-cdp-api-key-id
CDP_API_SECRET=your-cdp-api-secret
PAY_TO=0xYourWalletAddress
NETWORK=eip155:8453
PRICE=$0.01

# Hedera x402 (optional — enables Hedera testnet payment rail via Blocky402)
HEDERA_PAY_TO=0.0.XXXXX

# Supabase (API key management)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Silicon DNA
PORT=3001
NODE_ENV=production
TRUSTED_PROXY_IPS=127.0.0.1,::1
PRIVACY_PASS_KEY=
