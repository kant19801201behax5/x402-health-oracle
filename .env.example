# x402 Gateway Configuration
# Optional. Leave CDP_API_KEY_ID / CDP_API_SECRET EMPTY to run with the public x402.org facilitator
# on Base Sepolia (eip155:84532) — /v1/safe then answers 402 out of the box. Fill both for Base mainnet via CDP.
CDP_API_KEY_ID=
CDP_API_SECRET=
PAY_TO=0xYourWalletAddress
NETWORK=eip155:8453
PRICE=$0.01

# Hedera x402 (optional — enables Hedera testnet payment rail via Blocky402)
HEDERA_PAY_TO=

# Supabase (API key management)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Silicon DNA
PORT=3001
NODE_ENV=production
TRUSTED_PROXY_IPS=127.0.0.1,::1
PRIVACY_PASS_KEY=
